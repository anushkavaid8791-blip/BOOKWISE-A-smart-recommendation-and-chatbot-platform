# ========== SERVER ==========
PORT=5000
NODE_ENV=development

# ========== DATABASE ==========
# Choose ONE option below:

# Option 1: Local MongoDB (easiest for testing)
MONGODB_LOCAL=mongodb://localhost:27017/bookwise

# Option 2: Cloud MongoDB Atlas (recommended for production)
# Go to mongodb.com/cloud/atlas → create account → create cluster → copy connection string
#MONGODB_URI=mongodb+srv://username:8791anus@cluster0.mongodb.net/bookwise
MONGODB_URI=mongodb+srv://anushkavaid8791_db_user:8791anus@cluster-bookwise.ig4vutb.mongodb.net/?appName=cluster-bookwise
JWT_SECRET=your_super_secret_key_change_this_in_production_make_it_very_random
JWT_EXPIRE=7d

# ========== FIREBASE ==========
# Get from: Firebase Console → Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=bookwise-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-abc123@bookwise-project.iam.gserviceaccount.com

# ========== FRONTEND URLs (CORS) ==========
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://your-domain.com

# ========== BOOK APIs ==========

# Open Library (FREE - No API key needed!)
OPEN_LIBRARY_API=https://openlibrary.org/api

# Google Books API (optional - need API key from Google Cloud Console)
GOOGLE_BOOKS_API_KEY=YOUR_GOOGLE_BOOKS_API_KEY_HERE
GOOGLE_BOOKS_URL=https://www.googleapis.com/books/v1

# ========== AI/RECOMMENDATIONS ==========
# Groq API (free tier available)
# Get from: console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# ========== CACHE ==========
# How long to cache book data (in hours)
CACHE_EXPIRY_HOURS=24